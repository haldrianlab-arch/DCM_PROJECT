{
  "name": "sirama",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
