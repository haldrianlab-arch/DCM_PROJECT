# Salin ke .env.local (tidak di-commit) lalu isi nilainya. Lihat tech.md §13.

# Neon: pooled connection string branch `dev` untuk lokal.
DATABASE_URL=
# Opsional: koneksi tanpa pooler untuk migrasi (Vercel mengisinya otomatis).
DATABASE_URL_UNPOOLED=

# Better Auth (PR 2). Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cron harian (tech.md §8). Buat dengan: openssl rand -base64 32
CRON_SECRET=

# Password keempat akun demo (andi, rina, joko, sari @kampus.ac.id), minimal 8 karakter.
SEED_PASSWORD=
