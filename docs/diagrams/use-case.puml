@startuml
left to right direction
skinparam actorStyle awesome

actor Viewer
actor Teknisi
actor Admin
actor "Penjadwal harian" as Cron

Teknisi --|> Viewer
Admin --|> Teknisi

rectangle SIRAMA {
  usecase "Login" as UC01
  usecase "Melihat dashboard" as UC02
  usecase "Mencari device" as UC03
  usecase "Melihat elevation rack" as UC04
  usecase "Melihat detail device" as UC05

  usecase "Memindai QR device" as UC06
  usecase "Mengerjakan work order" as UC10
  usecase "Mengisi checklist" as UC11
  usecase "Melihat notifikasi" as UC12

  usecase "Mengelola site, room, dan rack" as UC20
  usecase "Mengelola katalog" as UC21
  usecase "Mengelola device" as UC22
  usecase "Memasang device ke rack" as UC23
  usecase "Validasi posisi rack" as UC24
  usecase "Mengelola cable" as UC25
  usecase "Mengelola maintenance plan" as UC26
  usecase "Membuat work order korektif" as UC27
  usecase "Melihat dampak (impact analysis)" as UC28
  usecase "Menugaskan teknisi" as UC29
  usecase "Membatalkan work order" as UC30
  usecase "Mengunduh label QR" as UC31
  usecase "Mencetak label massal" as UC32
  usecase "Mengelola user" as UC33
  usecase "Melihat audit log" as UC34

  usecase "Membuat work order preventif" as UC40
  usecase "Mengirim notifikasi" as UC41
}

Viewer --> UC01
Viewer --> UC02
Viewer --> UC03
Viewer --> UC04
Viewer --> UC05

Teknisi --> UC06
Teknisi --> UC10
Teknisi --> UC12

Admin --> UC20
Admin --> UC21
Admin --> UC22
Admin --> UC25
Admin --> UC26
Admin --> UC27
Admin --> UC29
Admin --> UC30
Admin --> UC31
Admin --> UC32
Admin --> UC33
Admin --> UC34

Cron --> UC40
Cron --> UC41

UC06 ..> UC05 : <<include>>
UC10 ..> UC11 : <<include>>
UC22 <.. UC23 : <<extend>>
UC23 ..> UC24 : <<include>>
UC27 ..> UC28 : <<include>>
@enduml
